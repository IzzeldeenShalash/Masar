API_PORT=3001
API_HOST=0.0.0.0
# Paste your online MongoDB connection string below, including the /masar database.
# Example format: mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER/masar?retryWrites=true&w=majority
MONGODB_URI=
DEMO_MODE=true
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
NODE_ENV=development
# Free public place search; replace with a compatible Photon deployment if needed.
PHOTON_BASE_URL=https://photon.komoot.io
# Private local photo storage, relative to apps/api (never served statically).
UPLOAD_DIR=uploads

# Local Ollama is called only by this backend, never directly by a phone.
AI_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose an exact installed local tag from ollama list.
OLLAMA_MODEL=
AI_TIMEOUT_MS=90000

# Stage 8: assistant and triage share this provider/model.
# mock is explicitly labeled and allowed only in non-production demo mode.
ASSISTANT_PROVIDER=mock
ASSISTANT_MODEL=
# Gemini: configure a model available to your account; no quota is assumed.
GEMINI_API_KEY=
# Optional Gemini photo analysis, also requires per-request user consent.
AI_IMAGES_ENABLED=false
# Voice is an uploaded recording, not a live call. No server audio is retained.
# whisper: self-host whisper.cpp server with multilingual model + format conversion.
# gemini: requires key, audio-capable VOICE_MODEL and explicit upload consent.
VOICE_PROVIDER=disabled
VOICE_MODEL=
WHISPER_URL=http://127.0.0.1:8082/inference
